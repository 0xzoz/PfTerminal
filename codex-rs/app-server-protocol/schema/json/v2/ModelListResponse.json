{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "InputModality": {
      "description": "Canonical user-input modality tags advertised by a model.",
      "oneOf": [
        {
          "description": "Plain text turns and tool payloads.",
          "enum": [
            "text"
          ],
          "type": "string"
        },
        {
          "description": "Image attachments included in user turns.",
          "enum": [
            "image"
          ],
          "type": "string"
        },
        {
          "description": "Audio attachments included in user turns.",
          "enum": [
            "audio"
          ],
          "type": "string"
        }
      ]
    },
    "LongContextRates": {
      "description": "API rates for a whole request whose input exceeds a published threshold, such as OpenAI's long-context price for prompts above 272K input tokens.",
      "properties": {
        "above_input_tokens": {
          "description": "The rates apply when the request's input tokens (cached and cache writes included) are strictly more than this.",
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "cache_write_milli_usd_per_million_tokens": {
          "format": "uint32",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "cached_input_milli_usd_per_million_tokens": {
          "format": "uint32",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "input_milli_usd_per_million_tokens": {
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "output_milli_usd_per_million_tokens": {
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "above_input_tokens",
        "input_milli_usd_per_million_tokens",
        "output_milli_usd_per_million_tokens"
      ],
      "type": "object"
    },
    "MeteredRates": {
      "description": "Per-token API rates, in milli-USD per million tokens.",
      "properties": {
        "cached_input_milli_usd_per_million_tokens": {
          "default": null,
          "format": "uint32",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "input_milli_usd_per_million_tokens": {
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "output_milli_usd_per_million_tokens": {
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "input_milli_usd_per_million_tokens",
        "output_milli_usd_per_million_tokens"
      ],
      "type": "object"
    },
    "Model": {
      "properties": {
        "additionalSpeedTiers": {
          "default": [],
          "description": "Deprecated: use `serviceTiers` instead.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "availabilityNux": {
          "anyOf": [
            {
              "$ref": "#/definitions/ModelAvailabilityNux"
            },
            {
              "type": "null"
            }
          ]
        },
        "defaultReasoningEffort": {
          "$ref": "#/definitions/ReasoningEffort"
        },
        "defaultServiceTier": {
          "default": null,
          "description": "Catalog default service tier id for this model, when one is configured.",
          "type": [
            "string",
            "null"
          ]
        },
        "description": {
          "type": "string"
        },
        "displayName": {
          "type": "string"
        },
        "hidden": {
          "type": "boolean"
        },
        "id": {
          "type": "string"
        },
        "inputModalities": {
          "default": [
            "text",
            "image"
          ],
          "items": {
            "$ref": "#/definitions/InputModality"
          },
          "type": "array"
        },
        "isDefault": {
          "type": "boolean"
        },
        "model": {
          "type": "string"
        },
        "orchestration": {
          "anyOf": [
            {
              "$ref": "#/definitions/ModelOrchestrationMetadata"
            },
            {
              "type": "null"
            }
          ],
          "description": "Canonical provider, capability, and billing policy used for spawned work.\n\nThis field is always present on the wire. `null` means the route is not trusted for orchestration; clients must not infer eligibility from its display name."
        },
        "serviceTiers": {
          "default": [],
          "items": {
            "$ref": "#/definitions/ModelServiceTier"
          },
          "type": "array"
        },
        "supportedReasoningEfforts": {
          "items": {
            "$ref": "#/definitions/ReasoningEffortOption"
          },
          "type": "array"
        },
        "supportsPersonality": {
          "default": false,
          "type": "boolean"
        },
        "upgrade": {
          "type": [
            "string",
            "null"
          ]
        },
        "upgradeInfo": {
          "anyOf": [
            {
              "$ref": "#/definitions/ModelUpgradeInfo"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "defaultReasoningEffort",
        "description",
        "displayName",
        "hidden",
        "id",
        "isDefault",
        "model",
        "supportedReasoningEfforts"
      ],
      "type": "object"
    },
    "ModelAvailabilityNux": {
      "properties": {
        "message": {
          "type": "string"
        }
      },
      "required": [
        "message"
      ],
      "type": "object"
    },
    "ModelBilling": {
      "description": "Billing data for an exact provider/model route.\n\nMonetary values use milli-USD per million tokens so catalogue metadata remains exact, serializable, and equality-comparable without floating point.",
      "oneOf": [
        {
          "properties": {
            "kind": {
              "enum": [
                "plan"
              ],
              "type": "string"
            },
            "relative_burn_millis": {
              "description": "Relative subscription-pool burn where 1000 means 1.0x.",
              "format": "uint32",
              "minimum": 0.0,
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "relative_burn_millis"
          ],
          "type": "object"
        },
        {
          "description": "Subscription-pool burn changes by time of day.\n\nThe normal peak/off-peak schedule remains present when a temporary promotion is active so clients can stop applying the discount after `promotion_valid_through_utc` without a catalogue release.",
          "properties": {
            "kind": {
              "enum": [
                "plan_schedule"
              ],
              "type": "string"
            },
            "off_peak_relative_burn_millis": {
              "description": "Normal off-peak relative burn where 1000 means 1.0x.",
              "format": "uint32",
              "minimum": 0.0,
              "type": "integer"
            },
            "peak_end_utc_hour": {
              "description": "Exclusive peak-window end, expressed as an hour in UTC.",
              "format": "uint8",
              "minimum": 0.0,
              "type": "integer"
            },
            "peak_relative_burn_millis": {
              "description": "Peak relative burn where 1000 means 1.0x.",
              "format": "uint32",
              "minimum": 0.0,
              "type": "integer"
            },
            "peak_start_utc_hour": {
              "description": "Inclusive peak-window start, expressed as an hour in UTC.",
              "format": "uint8",
              "minimum": 0.0,
              "type": "integer"
            },
            "peak_weekdays": {
              "anyOf": [
                {
                  "$ref": "#/definitions/WeekdaySet"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "UTC weekdays on which the peak window applies. Omitted means every day for backward compatibility with older catalogue entries."
            },
            "promotion_valid_through_utc": {
              "default": null,
              "type": [
                "string",
                "null"
              ]
            },
            "promotional_off_peak_relative_burn_millis": {
              "default": null,
              "format": "uint32",
              "minimum": 0.0,
              "type": [
                "integer",
                "null"
              ]
            }
          },
          "required": [
            "kind",
            "off_peak_relative_burn_millis",
            "peak_end_utc_hour",
            "peak_relative_burn_millis",
            "peak_start_utc_hour"
          ],
          "type": "object"
        },
        {
          "properties": {
            "cache_write_milli_usd_per_million_tokens": {
              "description": "The published cache-write price. Omitted means the catalogue states none, not that writes are free.",
              "format": "uint32",
              "minimum": 0.0,
              "type": [
                "integer",
                "null"
              ]
            },
            "cached_input_milli_usd_per_million_tokens": {
              "default": null,
              "format": "uint32",
              "minimum": 0.0,
              "type": [
                "integer",
                "null"
              ]
            },
            "input_milli_usd_per_million_tokens": {
              "format": "uint32",
              "minimum": 0.0,
              "type": "integer"
            },
            "kind": {
              "enum": [
                "metered"
              ],
              "type": "string"
            },
            "long_context": {
              "anyOf": [
                {
                  "$ref": "#/definitions/LongContextRates"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Rates for a request whose input exceeds a published threshold."
            },
            "output_milli_usd_per_million_tokens": {
              "format": "uint32",
              "minimum": 0.0,
              "type": "integer"
            },
            "valid_through_utc": {
              "description": "The last UTC instant (RFC 3339) the provider says these rates hold, such as the end of a promotion. Afterwards the row states no price.",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "input_milli_usd_per_million_tokens",
            "kind",
            "output_milli_usd_per_million_tokens"
          ],
          "type": "object"
        },
        {
          "description": "Per-token rates that differ between peak windows and the rest of the week.\n\nThe rate that applies is the one in force at the dispatch instant, so a ledger states what a request was actually charged, not a range.",
          "properties": {
            "kind": {
              "enum": [
                "metered_schedule"
              ],
              "type": "string"
            },
            "off_peak": {
              "$ref": "#/definitions/MeteredRates"
            },
            "off_peak_dates_utc": {
              "default": [],
              "description": "UTC calendar dates (`YYYY-MM-DD`) with no peak at all, such as the provider's published holidays.",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "peak": {
              "$ref": "#/definitions/MeteredRates"
            },
            "peak_weekdays": {
              "anyOf": [
                {
                  "$ref": "#/definitions/WeekdaySet"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "UTC weekdays on which the peak windows apply. Omitted means every day."
            },
            "peak_windows": {
              "description": "Peak windows. Outside every window the off-peak rates apply.",
              "items": {
                "$ref": "#/definitions/UtcHourWindow"
              },
              "type": "array"
            }
          },
          "required": [
            "kind",
            "off_peak",
            "peak",
            "peak_windows"
          ],
          "type": "object"
        },
        {
          "description": "The same provider/model route can use subscription capacity or API-key billing.\n\nBoth sides are exact. Runtime consumers resolve the active side from authentication; catalogue consumers that do not know authentication must present both, never guess.",
          "properties": {
            "api_key_cache_write_milli_usd_per_million_tokens": {
              "format": "uint32",
              "minimum": 0.0,
              "type": [
                "integer",
                "null"
              ]
            },
            "api_key_cached_input_milli_usd_per_million_tokens": {
              "default": null,
              "format": "uint32",
              "minimum": 0.0,
              "type": [
                "integer",
                "null"
              ]
            },
            "api_key_input_milli_usd_per_million_tokens": {
              "format": "uint32",
              "minimum": 0.0,
              "type": "integer"
            },
            "api_key_long_context": {
              "anyOf": [
                {
                  "$ref": "#/definitions/LongContextRates"
                },
                {
                  "type": "null"
                }
              ]
            },
            "api_key_output_milli_usd_per_million_tokens": {
              "format": "uint32",
              "minimum": 0.0,
              "type": "integer"
            },
            "api_key_valid_through_utc": {
              "description": "As `Metered::valid_through_utc`, for the API-key side only.",
              "type": [
                "string",
                "null"
              ]
            },
            "kind": {
              "enum": [
                "auth_dependent"
              ],
              "type": "string"
            },
            "plan_relative_burn_millis": {
              "format": "uint32",
              "minimum": 0.0,
              "type": "integer"
            }
          },
          "required": [
            "api_key_input_milli_usd_per_million_tokens",
            "api_key_output_milli_usd_per_million_tokens",
            "kind",
            "plan_relative_burn_millis"
          ],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "enum": [
                "local"
              ],
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "title": "LocalModelBilling",
          "type": "object"
        }
      ]
    },
    "ModelCapabilityTier": {
      "description": "Capability class used by orchestration when matching a model to spawned work.",
      "enum": [
        "frontier",
        "balanced",
        "fast",
        "legacy",
        "unclassified"
      ],
      "type": "string"
    },
    "ModelOrchestrationMetadata": {
      "description": "Canonical spawn-allocation metadata carried with a model through every catalogue layer.",
      "oneOf": [
        {
          "description": "Spawnable models must declare exact billing and capability metadata.",
          "properties": {
            "billing": {
              "$ref": "#/definitions/ModelBilling"
            },
            "capability": {
              "$ref": "#/definitions/ModelCapabilityTier"
            },
            "provider_id": {
              "type": "string"
            },
            "status": {
              "enum": [
                "eligible"
              ],
              "type": "string"
            }
          },
          "required": [
            "billing",
            "capability",
            "provider_id",
            "status"
          ],
          "type": "object"
        },
        {
          "description": "Non-spawnable models remain visible for existing sessions and manual use.",
          "properties": {
            "billing": {
              "anyOf": [
                {
                  "$ref": "#/definitions/ModelBilling"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The provider's published price, for cost accounting of manual use. Never used for spawn allocation."
            },
            "capability": {
              "$ref": "#/definitions/ModelCapabilityTier"
            },
            "provider_id": {
              "type": "string"
            },
            "reason": {
              "type": "string"
            },
            "status": {
              "enum": [
                "disabled"
              ],
              "type": "string"
            }
          },
          "required": [
            "capability",
            "provider_id",
            "reason",
            "status"
          ],
          "type": "object"
        }
      ]
    },
    "ModelServiceTier": {
      "properties": {
        "description": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "description",
        "id",
        "name"
      ],
      "type": "object"
    },
    "ModelUpgradeInfo": {
      "properties": {
        "migrationMarkdown": {
          "type": [
            "string",
            "null"
          ]
        },
        "model": {
          "type": "string"
        },
        "modelLink": {
          "type": [
            "string",
            "null"
          ]
        },
        "upgradeCopy": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "model"
      ],
      "type": "object"
    },
    "ReasoningEffort": {
      "description": "A non-empty reasoning effort value advertised by the model.",
      "minLength": 1,
      "type": "string"
    },
    "ReasoningEffortOption": {
      "properties": {
        "description": {
          "type": "string"
        },
        "reasoningEffort": {
          "$ref": "#/definitions/ReasoningEffort"
        }
      },
      "required": [
        "description",
        "reasoningEffort"
      ],
      "type": "object"
    },
    "UtcHourWindow": {
      "description": "A `[start, end)` window in whole UTC hours; it may wrap past midnight.",
      "properties": {
        "end_utc_hour": {
          "format": "uint8",
          "minimum": 0.0,
          "type": "integer"
        },
        "start_utc_hour": {
          "format": "uint8",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "end_utc_hour",
        "start_utc_hour"
      ],
      "type": "object"
    },
    "WeekdaySet": {
      "description": "UTC weekdays on which a scheduled plan peak applies.\n\n`ModelBilling::PlanSchedule::peak_weekdays == None` retains the legacy behavior where the peak window applies every day.",
      "properties": {
        "friday": {
          "type": "boolean"
        },
        "monday": {
          "type": "boolean"
        },
        "saturday": {
          "type": "boolean"
        },
        "sunday": {
          "type": "boolean"
        },
        "thursday": {
          "type": "boolean"
        },
        "tuesday": {
          "type": "boolean"
        },
        "wednesday": {
          "type": "boolean"
        }
      },
      "required": [
        "friday",
        "monday",
        "saturday",
        "sunday",
        "thursday",
        "tuesday",
        "wednesday"
      ],
      "type": "object"
    }
  },
  "properties": {
    "data": {
      "items": {
        "$ref": "#/definitions/Model"
      },
      "type": "array"
    },
    "nextCursor": {
      "description": "Opaque cursor to pass to the next call to continue after the last item. If None, there are no more items to return.",
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "data"
  ],
  "title": "ModelListResponse",
  "type": "object"
}
{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "ThreadAccountTokenUsage": {
      "description": "PF-84: provider-reported token usage of one named provider account: its provider id and account name, never credential material.",
      "properties": {
        "account": {
          "type": "string"
        },
        "providerId": {
          "type": "string"
        },
        "usage": {
          "$ref": "#/definitions/TokenUsageBreakdown"
        }
      },
      "required": [
        "account",
        "providerId",
        "usage"
      ],
      "type": "object"
    },
    "ThreadTokenUsage": {
      "properties": {
        "last": {
          "$ref": "#/definitions/TokenUsageBreakdown"
        },
        "modelContextWindow": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "total": {
          "$ref": "#/definitions/TokenUsageBreakdown"
        }
      },
      "required": [
        "last",
        "total"
      ],
      "type": "object"
    },
    "TokenUsageBreakdown": {
      "properties": {
        "cacheWriteInputTokens": {
          "default": 0,
          "format": "int64",
          "type": "integer"
        },
        "cachedInputTokens": {
          "format": "int64",
          "type": "integer"
        },
        "inputTokens": {
          "format": "int64",
          "type": "integer"
        },
        "outputTokens": {
          "format": "int64",
          "type": "integer"
        },
        "reasoningOutputTokens": {
          "format": "int64",
          "type": "integer"
        },
        "totalTokens": {
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "cachedInputTokens",
        "inputTokens",
        "outputTokens",
        "reasoningOutputTokens",
        "totalTokens"
      ],
      "type": "object"
    }
  },
  "properties": {
    "accountUsage": {
      "description": "PF-84: this thread's provider-reported usage per (provider, named account), `default` included. Sent only while named accounts are on.",
      "items": {
        "$ref": "#/definitions/ThreadAccountTokenUsage"
      },
      "type": [
        "array",
        "null"
      ]
    },
    "threadId": {
      "type": "string"
    },
    "tokenUsage": {
      "$ref": "#/definitions/ThreadTokenUsage"
    },
    "turnId": {
      "type": "string"
    }
  },
  "required": [
    "threadId",
    "tokenUsage",
    "turnId"
  ],
  "title": "ThreadTokenUsageUpdatedNotification",
  "type": "object"
}
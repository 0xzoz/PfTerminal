/target/
/target-*/

# TUI tests write tmux capture artifacts to tui/target/. Untracked build output
# left the receiving checkout dirty, which fails an integration receipt whose
# gates all passed - the receipt requires a clean tree after the tests run.
/tui/target/

# Recommended value of CARGO_TARGET_DIR when using Docker as explained in .devcontainer/README.md.
/target-amd64/

# Value of CARGO_TARGET_DIR when using .devcontainer/devcontainer.json.
/target-arm64/

# insta writes .snap.new PENDING artifacts next to the golden. They are never
# content: a passing test deletes them, which leaves the receiving tree dirty and
# fails a receipt whose gates all passed. Two receipts died on this before I
# fixed the cause rather than the instance.
*.snap.new
# Newer insta also writes .<file>.pending-snap for inline snapshots; same story.
.*.pending-snap

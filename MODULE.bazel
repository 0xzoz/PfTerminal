# Give Windows lint a native gnullvm exec set so proc-macros link against the
# same ABI as hermetic LLVM and BCR AWS-LC.
nightly_rust.repository_set(
    name = "rust_windows_x86_64_gnullvm",
    dev_components = True,
    edition = "2024",
    exec_compatible_with = [
        "@platforms//cpu:x86_64",
        "@platforms//os:windows",
        "@llvm//constraints/windows/abi:gnullvm",
        "@llvm//constraints/windows/crt:msvcrt",
    ],
    exec_triple = "x86_64-pc-windows-gnullvm",
    sha256s = RUST_TOOLCHAIN_SHA256S,
    target_compatible_with = [
        "@platforms//cpu:x86_64",
        "@platforms//os:windows",
        "@llvm//constraints/windows/abi:gnullvm",
        "@llvm//constraints/windows/crt:msvcrt",
    ],
    target_settings = ["@rules_rust//rust/toolchain/channel:nightly"],
    target_triple = "x86_64-pc-windows-gnullvm",
    versions = ["nightly/2026-08-23"],
)

# rules_rs only ships x86_64-pc-windows-msvc rustc for Windows exec platforms,
# and its toolchain matches any Windows exec platform. On the native gnullvm
# host (`//:local_windows`) that MSVC-host rustc compiles proc-macro DLLs with
# `--target=x86_64-pc-windows-gnullvm`, then refuses to load them (E0463, e.g.
# `rustversion` from `castaway`). Give native gnullvm exec a gnullvm-host
# stable rustc, matching the nightly lint set above.
nightly_rust.repository_set(
    name = "rust_windows_x86_64_gnullvm_stable",
    edition = "2024",
    exec_compatible_with = [
        "@platforms//cpu:x86_64",
        "@platforms//os:windows",
        "@llvm//constraints/windows/abi:gnullvm",
        "@llvm//constraints/windows/crt:msvcrt",
    ],
    exec_triple = "x86_64-pc-windows-gnullvm",
    sha256s = RUST_TOOLCHAIN_SHA256S,
    target_compatible_with = [
        "@platforms//cpu:x86_64",
        "@platforms//os:windows",
        "@llvm//constraints/windows/abi:gnullvm",
        "@llvm//constraints/windows/crt:msvcrt",
    ],
    target_settings = ["@rules_rust//rust/toolchain/channel:stable"],
    target_triple = "x86_64-pc-windows-gnullvm",
    versions = ["1.99.1"],
)
use_repo(nightly_rust, "rust_toolchains")


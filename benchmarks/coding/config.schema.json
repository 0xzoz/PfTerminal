{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Corbanu coding benchmark config",
  "type": "object",
  "required": ["run_dir", "waves", "caps", "agents", "tasks"],
  "properties": {
    "run_dir": {
      "type": "string",
      "description": "Absolute path or path relative to the config file."
    },
    "waves": {"type": "integer", "minimum": 1},
    "caps": {
      "type": "object",
      "required": ["timeout_seconds", "max_total_runs"],
      "properties": {
        "timeout_seconds": {"type": "integer", "minimum": 1},
        "max_total_runs": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "agents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "kind", "binary", "provider", "model", "lane"],
        "properties": {
          "name": {"type": "string"},
          "kind": {
            "type": "string",
            "enum": ["corbanu", "hermes", "kilo", "codex", "claude-code"]
          },
          "binary": {"type": "string"},
          "provider": {"type": "string"},
          "model": {"type": "string"},
          "lane": {"type": "string"},
          "required_env": {
            "type": "array",
            "items": {"type": "string"}
          },
          "command": {
            "type": "array",
            "items": {"type": "string"},
            "description": "Optional argv template. No shell is used."
          },
          "stdin_prompt": {"type": "boolean"}
        },
        "additionalProperties": false
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "baseline", "prompt", "verifier"],
        "properties": {
          "name": {"type": "string"},
          "baseline": {"type": "string"},
          "prompt": {"type": "string"},
          "verifier": {"type": "string"},
          "core_rel": {"type": "string"},
          "timeout_seconds": {"type": "integer", "minimum": 1},
          "visible_command": {
            "type": "array",
            "items": {"type": "string"}
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

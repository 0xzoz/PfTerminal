#!/bin/bash
# local. usage: costcmd <session> <name> <wait-regex> <cost args...>: run /cost ARGS (closing a popup first) and capture
s=$1; name=$2; re=$3; shift 3; Q=$(dirname "$0")/q
for i in 1 2 3 4 5 6; do $Q sh "tmux -L q-$s capture-pane -p -t $s | grep -q 'Esc back/close'" || break; $Q $s key Escape; done
$Q $s text "/cost $*"; $Q $s key Enter; $Q $s wait "$re" 30 >/dev/null; sleep 1
if $Q sh "tmux -L q-$s capture-pane -p -t $s | grep -q 'Esc back/close'"; then $Q $s scroll "$name" ${STEPS:-60}; else $Q $s cap "$name"; fi

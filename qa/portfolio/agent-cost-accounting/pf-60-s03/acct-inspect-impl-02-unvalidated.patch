+fn money(value: Decimal) -> String {
+    let display = value.display();
+    format!(
+        "${}{}{}",
+        display.text,
+        if display.rounded { " (rounded)" } else { "" },
+        if display.nonzero_sub_micro {
+            " (nonzero, less than $0.000001)"
+        } else {
+            ""
+        }
+    )
+}

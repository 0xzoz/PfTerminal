# Managed by Corbanu Terminal /security (Aggressive). Choosing Permissive removes this file.
prefix_rule(pattern = ["corbanu", "vault"], decision = "forbidden", justification = "Security level Aggressive: agents cannot use the Corbanu vault.")
prefix_rule(pattern = ["codex", "vault"], decision = "forbidden", justification = "Security level Aggressive: agents cannot use the Corbanu vault.")
